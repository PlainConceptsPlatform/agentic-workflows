# Per-instance environment for a self-hosted runner.
# Copy to /opt/actions-runner/<n>/.env, owned by the runner user. runsvc.sh loads it, so the
# whole job tree inherits these values. Restart the service after editing.
#
# All four instances run as the same user, `runner`. Only values that genuinely cannot be
# shared belong here. Everything else two concurrent jobs would collide over is handled when
# the workflows are compiled, in loops/scripts/compile-agent-workflows.mjs.

LANG=C.UTF-8

# OpenCode runs on the host, one server per runner. Two runners cannot bind the same port.
# Instance 1 may omit this and take the 4096 default.
OPENCODE_PORT=4092

# The MCP gateway is published through the runner's Docker-in-Docker daemon onto the host
# loopback, and gh-aw health-checks it there. Four daemons share one loopback, so two jobs on
# 8080 collide with "Port 8080 does not appear to be listening". Instance 1 may omit this and
# take the 8080 default. The port here must match the -p published by that runner's dind
# container: see dind.md.
MCP_GATEWAY_PORT=8082

# DO NOT SET DOCKER_HOST HERE.
#
# Each runner has its own Docker-in-Docker daemon, but pointing the whole runner at it breaks
# CI: ports published inside a DinD daemon are unreachable from the host unless that daemon
# publishes them through, so a job reaching a service container on localhost, as app-ci.yml
# does for SQL Server, gets nothing. DOCKER_HOST is set in the two agent-lock steps that need
# it, derived from $RUNNER_NAME. Everything else uses the host daemon.
