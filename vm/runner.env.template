# Per-instance environment for a self-hosted runner.
# Copy to /opt/actions-runner/<n>/.env, owned by the runner user. runsvc.sh loads it, so the
# whole job tree inherits these values. Restart the service after editing.
#
# Only the values that cannot be shared live here. Everything else a concurrent agent job would
# collide over is isolated when the workflows are compiled, in loops/scripts/compile-agent-workflows.mjs.

LANG=C.UTF-8

# The MCP gateway is published on the host loopback as 127.0.0.1:<port>. Two runners cannot
# bind the same one: the second job fails with "Port 8080 does not appear to be listening".
# Instance 1 may omit this and take the 8080 default.
MCP_GATEWAY_PORT=8082

# OpenCode runs as a warm server per runner, reused across that runner's jobs. Sharing one
# server across runners means one job's teardown can pull the backend out from under another.
# Its data directory is keyed on the runner name at compile time, so only the port is set here.
# Instance 1 may omit this and take the 4096 default.
OPENCODE_PORT=4092

# Required for every runner after the first. awf names its containers awf-agent, awf-squid and
# awf-api-proxy with no way to change them, so two agent jobs on one daemon recreate each other's
# containers and the first dies with exit 137. A daemon per runner puts the identical names in
# separate namespaces. awf reads this variable natively, so no workflow changes.
DOCKER_HOST=unix:///run/user/1002/docker.sock
XDG_RUNTIME_DIR=/run/user/1002
