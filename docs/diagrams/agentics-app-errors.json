  "cards": [
    {
      "dot": "cyan",
      "title": "No model, no paraphrasing",
      "items": [
        "A model asked to summarise a stack trace paraphrases it",
        "A paraphrased stack trace is a wrong issue",
        "Scrubbing comes before scanning: masking a GUID keeps the job alive"
      ]
    },
    {
      "dot": "rose",
      "title": "Two failure modes, handled differently",
      "items": [
        "A field nobody agreed to publish: nothing filed at all, run goes red",
        "A body that trips the scanner: one row withheld, the rest filed, run goes red",
        "Both turn the run red so the field gets fixed"
      ]
    }
