  "cards": [
    {
      "dot": "cyan",
      "title": "Router guarantees",
      "items": [
        "One event creates one run, at most one thing happens",
        "Classification is pure shell with no network calls",
        "Bots authorize via bot-working label pattern"
      ]
    },
    {
      "dot": "amber",
      "title": "Split-out workflows",
      "items": [
        "Jobs that start no agent run on the events they need",
        "A push, a CI result or the hourly tick opens no router run",
        "Moved operations still dispatch to the router and are forwarded"
      ]
