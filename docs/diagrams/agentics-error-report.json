  "cards": [
    {
      "dot": "cyan",
      "title": "Only package-owned facts cross the boundary",
      "items": [
        "File names, job and step names, a conclusion, a runner label, a count",
        "A matched entry from a catalogue of sixteen known failure shapes",
        "No free text: no log line, no branch name, no issue title, no path, no URL"
      ]
    },
    {
      "dot": "rose",
      "title": "Fails closed and loud",
      "items": [
        "A report the scanner flags is not filed and the run goes red",
        "At least as many scans as upstream writes",
        "Both exit paths call setFailed"
      ]
    }
  ]
