# Single source of truth for tool versions baked into the runner image.
# Keep in sync with loops/workflows/shared/opencode-ci.md when that file bumps
# its pins - a rebuilt image with stale versions makes the "already installed"
# guards in the workflows fail and re-download on every job.
RUNNER_VERSION=2.337.0
DOTNET_MAJOR=10.0
TRIVY_VERSION=0.74.0
RIPGREP_VERSION=14.1.1
RTK_VERSION=0.44.1
RTK_SHA256=986f29704469b3d1051e2474105c6c75ab8b73651068dcd61612c1fb3938ad95
AGENTMEMORY_VERSION=0.9.28
CODEGRAPH_VERSION=1.6.0
OPENSPEC_VERSION=1.8.0
OPENCODE_VERSION=2.0.22
NODE_MAJOR=22

# Docker images pulled at bake time. reset_state in cloud-init.yaml prunes containers,
# volumes and networks between jobs but never images, so these stay warm for every job
# a VM serves instead of being downloaded each time.
#
# The gh-aw sandbox images are whatever GH_AW_VERSION compiles into a lock file. CI
# compiles the workers with that version and fails if this list disagrees, so bump
# GH_AW_VERSION here together with loops/templates/agentics/agentics-checks.yml.
GH_AW_VERSION=v0.87.5
GH_AW_IMAGES="
ghcr.io/github/gh-aw-firewall/agent:0.28.7@sha256:40a1e30b1b8d70642d4292485146cd5af612730d7a6a2e12706ddd13df375059
ghcr.io/github/gh-aw-firewall/api-proxy:0.28.7@sha256:4f209dd4cbc74d47a6c7379956143de293429d1b1b2fb2647776cdcbf65836a1
ghcr.io/github/gh-aw-firewall/squid:0.28.7@sha256:fb362a08d4d2f0da6c036e3f5d3b2fd87931e857fec3ca4a241cd2f2b61131f9
ghcr.io/github/gh-aw-mcpg:v0.4.10@sha256:08bb5fa417aed94b40a14e2b7b3ae457531a5f22b143a32fe58317139d9b8f42
ghcr.io/github/gh-aw-node@sha256:bac2192f6374d6262116399b34fc5e143d576f82719e90a18261cae7480f4d4e
ghcr.io/github/github-mcp-server:v1.10.0@sha256:097512ddf58af80a620c177ae9cad93448f9a2a55c70ee8fde5cec6714522a8c
"
# A CU tag, not 2022-latest: a moving tag would be stale the day after the bake and every
# consumer still pinned to it would pull anyway. Consumers reference this exact tag.
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-CU27-ubuntu-22.04
# The @playwright/test version consumers resolve today. Used twice: the system libraries
# Chromium needs are installed with this version's install-deps, and its container image
# is pulled for consumers that still run their e2e inside it.
PLAYWRIGHT_VERSION=1.62.1
